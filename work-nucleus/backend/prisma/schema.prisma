generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  HIRING_MANAGER
  INTERVIEWER
  VIEWER
  SUPPORT_REP
  SUPPORT_ADMIN
}

enum SkillCategory {
  TECHNICAL
  LEADERSHIP
  BEHAVIOURAL
  COMMUNICATION
  DOMAIN
}

enum HiringPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SkillPriority {
  MUST_HAVE
  NICE_TO_HAVE
}

enum JdStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
}

enum StageType {
  SCREENING
  TECHNICAL
  HR
  LEADERSHIP
  CULTURAL
  OFFER
  CUSTOM
}

enum CandidateSource {
  REFERRAL
  JOB_BOARD
  DIRECT
  AGENCY
  INTERNAL
}

enum ApplicationStatus {
  ACTIVE
  SELECTED
  REJECTED
  ON_HOLD
  WITHDRAWN
}

enum StageOutcome {
  PASSED
  REJECTED
  SKIPPED
}

enum Recommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum DecisionType {
  SELECTED
  REJECTED
}

enum TrainingCategory {
  JD_FORMAT
  INTERVIEWING_SKILLS
  FEEDBACK_GUIDELINES
  HIRING_PROCESS
}

// ── Job Publishing Enums ────────────────────────────────────────

enum PublishChannel {
  LINKEDIN
  INDEED
  NAUKRI
  CUSTOM
}

enum PublishStatus {
  PENDING
  PUBLISHED
  FAILED
  REMOVED
}

// ── Support Portal Enums ────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  TECHNICAL
  BILLING
  FEATURE_REQUEST
  BUG_REPORT
  ONBOARDING
  BGV_DISCREPANCY
  GENERAL
}

enum EscalationLevel {
  L1
  L2
  L3
  MANAGEMENT
}

enum SessionType {
  SHADOW
  IMPERSONATE
}

// ── Offer Letter Enums (Phase 1) ────────────────────────────────

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum ESignProvider {
  DIGIO
  LEEGALITY
}

enum ESignStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  EXPIRED
  FAILED
}

enum JoiningStatus {
  PENDING
  IN_PROGRESS
  DOCUMENTS_PENDING
  READY_TO_JOIN
  JOINED
  CANCELLED
}

enum OfferApprovalDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

// ── BGV Enums (Phase 2) ─────────────────────────────────────────

enum BgvProfileStatus {
  NOT_STARTED
  CONSENT_PENDING
  IN_PROGRESS
  NEEDS_REVIEW
  COMPLETED
  CANCELLED
}

enum BgvCheckType {
  PAN
  AADHAAR
  PASSPORT
  EDUCATION
  EMPLOYMENT_HISTORY
  ADDRESS_CURRENT
  ADDRESS_PERMANENT
  CRIMINAL_COURT
  POLICE_VERIFICATION
  CREDIT_CHECK
  GLOBAL_DATABASE
  DRUG_TEST
  REFERENCE
}

enum BgvCheckStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum BgvFinding {
  PENDING
  CLEAR
  DISCREPANCY
  UNABLE_TO_VERIFY
}

enum BgvRiskScore {
  GREEN
  AMBER
  RED
}

enum BgvVendor {
  AUTHBRIDGE
  ONGRID
  IDFY
  SPRINGVERIFY
}

// ── Appraisal Enums (Phase 3) ───────────────────────────────────

enum CycleType {
  MID_YEAR
  ANNUAL
  PROBATION
  SPECIAL
}

enum CycleStatus {
  DRAFT
  GOAL_SETTING
  SELF_ASSESSMENT
  MANAGER_REVIEW
  PEER_FEEDBACK
  CALIBRATION
  COMMUNICATED
  CLOSED
}

enum GoalType {
  OKR
  KRA
  COMPETENCY
  VALUE
  STRETCH
}

enum GoalStatus {
  DRAFT
  AGREED
  IN_PROGRESS
  COMPLETED
  PARTIAL
  NOT_MET
  ABANDONED
}

enum AssessmentType {
  SELF
  MANAGER
  SKIP_LEVEL
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FINALISED
  REOPENED
}

enum PeerRelationship {
  PEER
  REPORT
  MANAGER
  SKIP_LEVEL
  CROSS_FUNCTIONAL
  EXTERNAL
}

enum FeedbackRequestStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  SUBMITTED
  EXPIRED
}

enum CalibrationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ── Compensation Engine Enums (Phase 4) ─────────────────────────

enum BudgetStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  LOCKED
  DISTRIBUTED
  CLOSED
}

enum RevisionStatus {
  DRAFT
  MANAGER_REVIEW
  DIRECTOR_APPROVAL
  CHRO_APPROVAL
  CEO_APPROVAL
  APPROVED
  LOCKED
  COMMUNICATED
}

enum CompLetterStatus {
  PENDING
  RENDERED
  DELIVERED
  ACKNOWLEDGED
}

// ── Phase 5 Enums (Hardening) ───────────────────────────────────

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
  PUSH
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum ReportSource {
  HIRING
  APPLICATIONS
  APPRAISAL
  COMPENSATION
  BGV
  ATTRITION
}

enum ReportVisualization {
  TABLE
  BAR
  LINE
  FUNNEL
  HEATMAP
}

enum SecurityEventType {
  AUTH_LOGIN
  AUTH_LOGOUT
  AUTH_FAILED
  ACCESS_GRANTED
  ACCESS_DENIED
  ROLE_CHANGED
  SECRET_ACCESSED
  DATA_EXPORTED
  CONFIG_CHANGED
}

// ── Core Models ─────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  hiringPlans      HiringPlan[]
  candidates       Candidate[]
  trainingModules  TrainingModule[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  settings           OrgSettings?
  healthMetrics      OrgHealthMetric[]
  jobPublishings     JobPublishing[]
  supportTickets     SupportTicket[]
  supportSessions    SupportSession[]
  dashboardInsights  DashboardInsight[]
  offerTemplates     OfferTemplate[]
  offers             Offer[]
  joiningChecklists  JoiningChecklist[]
  bgvProfiles        BgvProfile[]
  appraisalCycles    AppraisalCycle[]
  orgGoals           OrgGoal[]
  appraisalBudgets   AppraisalBudget[]
  compensationRevisions CompensationRevision[]
  reportDefinitions  ReportDefinition[]
  notificationLogs   NotificationLog[]
  securityLogs       SecurityLog[]
  aiCallLogs         AiCallLog[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  email     String   @unique
  auth0Sub  String   @unique @map("auth0_sub")
  name      String
  role      Role     @default(VIEWER)
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  managedHiringPlans HiringPlan[] @relation("HiringManager")
  createdHiringPlans HiringPlan[] @relation("PlanCreator")
  createdJobDescriptions  JobDescription[] @relation("JdCreator")
  approvedJobDescriptions JobDescription[] @relation("JdApprover")
  stageAssignments        PipelineStageInterviewer[]
  interviewFeedbacks      InterviewFeedback[]
  decisionsDecided        SelectionDecision[]  @relation("DecisionDecider")
  decisionsApproved       SelectionDecision[]  @relation("DecisionApprover")
  trainingCompletions     TrainingCompletion[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  assignedTickets         SupportTicket[]      @relation("TicketAssignee")
  supportNotes            SupportNote[]        @relation("NoteAuthor")
  escalationsCreated      SupportEscalation[]  @relation("EscalationCreator")
  supportSessions         SupportSession[]     @relation("SupportSessionUser")
  targetedBySessions      SupportSession[]     @relation("SupportSessionTarget")
  dashboardInsights       DashboardInsight[]
  createdOfferTemplates   OfferTemplate[]      @relation("OfferTemplateCreator")
  createdOffers           Offer[]              @relation("OfferCreator")
  buddyForJoinings        CandidateJoining[]   @relation("JoiningBuddy")
  managerForJoinings      CandidateJoining[]   @relation("JoiningReportingManager")
  goalsAsEmployee         Goal[]               @relation("GoalEmployee")
  goalsAsManager          Goal[]               @relation("GoalManager")
  ownedOrgGoals           OrgGoal[]            @relation("OrgGoalOwner")
  selfAssessments         AppraisalAssessment[] @relation("AssessmentEmployee")
  managedAssessments      AppraisalAssessment[] @relation("AssessmentManager")
  peerFeedbackAsSubject   PeerFeedbackRequest[] @relation("PeerSubject")
  peerFeedbackAsReviewer  PeerFeedbackRequest[] @relation("PeerReviewer")
  peerFeedbackRequested   PeerFeedbackRequest[] @relation("PeerRequester")
  facilitatedCalibrations CalibrationSession[] @relation("CalibrationFacilitator")
  approvedBudgets         AppraisalBudget[]    @relation("BudgetApprover")
  comprevisionsAsEmployee CompensationRevision[] @relation("RevisionEmployee")
  pushSubscriptions       PushSubscription[]
  notificationPrefs       UserNotificationPref[]
  reportDefinitions       ReportDefinition[]   @relation("ReportCreator")
  notificationLogs        NotificationLog[]

  @@index([orgId])
  @@index([auth0Sub])
  @@map("users")
}

model Skill {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  category  SkillCategory
  industry  String?
  isGlobal  Boolean       @default(false) @map("is_global")
  createdAt DateTime      @default(now())

  hiringPlanSkills    HiringPlanSkill[]
  feedbackRatings     FeedbackSkillRating[]

  @@map("skills")
}

model HiringPlan {
  id                   String           @id @default(uuid()) @db.Uuid
  orgId                String           @db.Uuid
  title                String
  industry             String
  department           String
  quarter              Int
  year                 Int
  totalRoles           Int              @map("total_roles")
  filledRoles          Int              @default(0) @map("filled_roles")
  status               HiringPlanStatus @default(DRAFT)
  budgetMin            Decimal          @map("budget_min") @db.Decimal(12, 2)
  budgetMax            Decimal          @map("budget_max") @db.Decimal(12, 2)
  currency             String           @default("INR")
  benefits             Json             @default("[]")
  hiringManagerId      String           @map("hiring_manager_id") @db.Uuid
  reportingManagerName String           @map("reporting_manager_name")
  hodName              String           @map("hod_name")
  teamSize             Int?             @map("team_size")
  teamLevels           String?          @map("team_levels")
  designation          String
  notes                String?
  createdById          String           @map("created_by_id") @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization   Organization      @relation(fields: [orgId], references: [id])
  hiringManager  User              @relation("HiringManager", fields: [hiringManagerId], references: [id])
  createdBy      User              @relation("PlanCreator", fields: [createdById], references: [id])
  skills           HiringPlanSkill[]
  jobDescriptions  JobDescription[]
  pipelineStages   PipelineStage[]
  applications     CandidateApplication[]
  publishings      JobPublishing[]

  @@index([orgId])
  @@index([status])
  @@index([hiringManagerId])
  @@map("hiring_plans")
}

model HiringPlanSkill {
  id             String        @id @default(uuid()) @db.Uuid
  hiringPlanId   String        @map("hiring_plan_id") @db.Uuid
  skillId        String        @map("skill_id") @db.Uuid
  priority       SkillPriority
  minProficiency Int           @map("min_proficiency")

  hiringPlan HiringPlan @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id])

  @@unique([hiringPlanId, skillId])
  @@map("hiring_plan_skills")
}

model JobDescription {
  id                   String   @id @default(uuid()) @db.Uuid
  hiringPlanId         String   @map("hiring_plan_id") @db.Uuid
  version              Int      @default(1)
  content              Json     @default("{}")
  fitmentMapping       Json     @default("{}") @map("fitment_mapping")
  evaluationParameters Json     @default("{}") @map("evaluation_parameters")
  generatedByAi        Boolean  @default(true) @map("generated_by_ai")
  aiPromptUsed         String?  @map("ai_prompt_used")
  status               JdStatus @default(DRAFT)
  createdById          String   @map("created_by_id") @db.Uuid
  approvedById         String?  @map("approved_by_id") @db.Uuid
  approvedAt           DateTime? @map("approved_at")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hiringPlan  HiringPlan      @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("JdCreator", fields: [createdById], references: [id])
  approvedBy  User?           @relation("JdApprover", fields: [approvedById], references: [id])
  publishings JobPublishing[]

  @@index([hiringPlanId])
  @@index([status])
  @@map("job_descriptions")
}

model PipelineStage {
  id               String    @id @default(uuid()) @db.Uuid
  hiringPlanId     String    @map("hiring_plan_id") @db.Uuid
  name             String
  stageOrder       Int       @map("stage_order")
  stageType        StageType @map("stage_type")
  maxDurationDays  Int?      @map("max_duration_days")
  skillsToEvaluate Json      @default("[]") @map("skills_to_evaluate")
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hiringPlan   HiringPlan                @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  interviewers PipelineStageInterviewer[]
  applications CandidateApplication[]    @relation("CurrentStage")
  stageHistory CandidateStageHistory[]
  feedbacks    InterviewFeedback[]

  @@index([hiringPlanId])
  @@map("pipeline_stages")
}

model PipelineStageInterviewer {
  id          String  @id @default(uuid()) @db.Uuid
  stageId     String  @map("stage_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  isMandatory Boolean @default(false) @map("is_mandatory")

  stage PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@unique([stageId, userId])
  @@map("pipeline_stage_interviewers")
}

model Candidate {
  id              String          @id @default(uuid()) @db.Uuid
  orgId           String          @db.Uuid
  name            String
  email           String
  phone           String?
  resumeUrl       String?         @map("resume_url")
  source          CandidateSource
  currentCompany  String?         @map("current_company")
  currentRole     String?         @map("current_role")
  experienceYears Decimal?        @map("experience_years") @db.Decimal(4, 1)
  expectedCtc     Decimal?        @map("expected_ctc") @db.Decimal(12, 2)
  noticePeriodDays Int?           @map("notice_period_days")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization           @relation(fields: [orgId], references: [id])
  applications CandidateApplication[]
  bgvProfiles  BgvProfile[]

  @@unique([orgId, email])
  @@index([orgId])
  @@map("candidates")
}

model CandidateApplication {
  id              String            @id @default(uuid()) @db.Uuid
  candidateId     String            @map("candidate_id") @db.Uuid
  hiringPlanId    String            @map("hiring_plan_id") @db.Uuid
  currentStageId  String?           @map("current_stage_id") @db.Uuid
  status          ApplicationStatus @default(ACTIVE)
  appliedAt       DateTime          @default(now()) @map("applied_at")
  stageEnteredAt  DateTime          @default(now()) @map("stage_entered_at")
  completedAt     DateTime?         @map("completed_at")
  rejectionReason String?           @map("rejection_reason")
  selectionNotes  String?           @map("selection_notes")
  coverLetter     String?           @map("cover_letter")
  totalScore      Decimal?          @map("total_score") @db.Decimal(5, 2)
  aiSummary       String?           @map("ai_summary")
  aiMatchScore    Decimal?          @map("ai_match_score") @db.Decimal(5, 2)
  aiMatchSummary  String?           @map("ai_match_summary")

  candidate    Candidate               @relation(fields: [candidateId], references: [id])
  hiringPlan   HiringPlan              @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  currentStage PipelineStage?          @relation("CurrentStage", fields: [currentStageId], references: [id])
  stageHistory CandidateStageHistory[]
  feedbacks    InterviewFeedback[]
  decision     SelectionDecision?
  offer        Offer?

  @@unique([candidateId, hiringPlanId])
  @@index([hiringPlanId])
  @@index([currentStageId])
  @@map("candidate_applications")
}

model CandidateStageHistory {
  id            String        @id @default(uuid()) @db.Uuid
  applicationId String        @map("application_id") @db.Uuid
  stageId       String        @map("stage_id") @db.Uuid
  enteredAt     DateTime      @default(now()) @map("entered_at")
  exitedAt      DateTime?     @map("exited_at")
  outcome       StageOutcome?

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage       PipelineStage        @relation(fields: [stageId], references: [id])

  @@index([applicationId])
  @@map("candidate_stage_history")
}

model InterviewFeedback {
  id               String         @id @default(uuid()) @db.Uuid
  applicationId    String         @map("application_id") @db.Uuid
  stageId          String         @map("stage_id") @db.Uuid
  interviewerId    String         @map("interviewer_id") @db.Uuid
  overallRating    Int            @map("overall_rating")
  recommendation   Recommendation
  qualitativeNotes String?        @map("qualitative_notes")
  strengths        String?
  concerns         String?
  durationMinutes  Int?           @map("duration_minutes")
  isSubmitted      Boolean        @default(false) @map("is_submitted")
  submittedAt      DateTime?      @map("submitted_at")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  application  CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage        PipelineStage        @relation(fields: [stageId], references: [id])
  interviewer  User                 @relation(fields: [interviewerId], references: [id])
  skillRatings FeedbackSkillRating[]

  @@unique([applicationId, stageId, interviewerId])
  @@index([applicationId])
  @@index([interviewerId])
  @@map("interview_feedbacks")
}

model FeedbackSkillRating {
  id         String  @id @default(uuid()) @db.Uuid
  feedbackId String  @map("feedback_id") @db.Uuid
  skillId    String  @map("skill_id") @db.Uuid
  rating     Int
  notes      String?

  feedback InterviewFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  skill    Skill             @relation(fields: [skillId], references: [id])

  @@unique([feedbackId, skillId])
  @@map("feedback_skill_ratings")
}

model SelectionDecision {
  id                  String       @id @default(uuid()) @db.Uuid
  applicationId       String       @unique @map("application_id") @db.Uuid
  decision            DecisionType
  decidedById         String       @map("decided_by_id") @db.Uuid
  decisionNotes       String?      @map("decision_notes")
  approvedById        String?      @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?    @map("approved_at")
  offerCtc            Decimal?     @map("offer_ctc") @db.Decimal(12, 2)
  offerDesignation    String?      @map("offer_designation")
  joiningDate         DateTime?    @map("joining_date")
  communicationDraft  Json?        @map("communication_draft")
  communicationSent   Boolean      @default(false) @map("communication_sent")
  communicationSentAt DateTime?    @map("communication_sent_at")
  createdAt           DateTime     @default(now())

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decidedBy   User                 @relation("DecisionDecider", fields: [decidedById], references: [id])
  approvedBy  User?                @relation("DecisionApprover", fields: [approvedById], references: [id])

  @@index([applicationId])
  @@map("selection_decisions")
}

model TrainingModule {
  id               String           @id @default(uuid()) @db.Uuid
  orgId            String           @db.Uuid
  title            String
  contentMarkdown  String           @map("content_markdown")
  category         TrainingCategory
  isDefault        Boolean          @default(false) @map("is_default")
  estimatedMinutes Int?             @map("estimated_minutes")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id])
  completions  TrainingCompletion[]

  @@index([orgId])
  @@map("training_modules")
}

model TrainingCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  moduleId    String   @map("module_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at")

  user   User           @relation(fields: [userId], references: [id])
  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("training_completions")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  orgId      String   @db.Uuid
  type       String
  title      String
  body       String
  read       Boolean  @default(false)
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  actionUrl  String?  @map("action_url")
  createdAt  DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([userId, read])
  @@index([orgId])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OrgSettings {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @unique @db.Uuid
  settings Json     @default("{}")
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("org_settings")
}

// ── Job Publishing Models ───────────────────────────────────────

model JobPublishing {
  id               String         @id @default(uuid()) @db.Uuid
  jobDescriptionId String         @map("job_description_id") @db.Uuid
  hiringPlanId     String         @map("hiring_plan_id") @db.Uuid
  orgId            String         @db.Uuid
  channel          PublishChannel
  status           PublishStatus  @default(PENDING)
  externalJobId    String?        @map("external_job_id")
  externalUrl      String?        @map("external_url")
  publicSlug       String         @unique @map("public_slug")
  publishedAt      DateTime?      @map("published_at")
  errorMessage     String?        @map("error_message")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id])
  hiringPlan     HiringPlan     @relation(fields: [hiringPlanId], references: [id])
  organization   Organization   @relation(fields: [orgId], references: [id])

  @@index([hiringPlanId])
  @@index([publicSlug])
  @@map("job_publishings")
}

// ── Support Portal Models ───────────────────────────────────────

model OrgHealthMetric {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @db.Uuid
  metricDate      DateTime @map("metric_date")
  activeUsers     Int      @map("active_users")
  hiringPlanCount Int      @map("hiring_plan_count")
  openRoles       Int      @map("open_roles")
  fillRate        Decimal  @map("fill_rate") @db.Decimal(5, 2)
  avgTimeToHire   Int?     @map("avg_time_to_hire")
  healthScore     Int      @map("health_score")
  riskFlags       Json     @default("[]") @map("risk_flags")
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, metricDate])
  @@index([orgId])
  @@index([metricDate])
  @@map("org_health_metrics")
}

model SupportTicket {
  id              String         @id @default(uuid()) @db.Uuid
  orgId           String         @db.Uuid
  title           String
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  category        TicketCategory @default(GENERAL)
  assigneeId      String?        @map("assignee_id") @db.Uuid
  reportedBy      String         @map("reported_by")
  slaDeadline     DateTime?      @map("sla_deadline")
  firstResponseAt DateTime?      @map("first_response_at")
  resolvedAt      DateTime?      @map("resolved_at")
  closedAt        DateTime?      @map("closed_at")
  tags            Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  assignee     User?             @relation("TicketAssignee", fields: [assigneeId], references: [id])
  notes        SupportNote[]
  escalations  SupportEscalation[]

  @@index([orgId])
  @@index([status])
  @@index([assigneeId])
  @@index([priority])
  @@index([slaDeadline])
  @@map("support_tickets")
}

model SupportNote {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String
  isInternal Boolean  @default(true) @map("is_internal")
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("support_notes")
}

model SupportEscalation {
  id            String          @id @default(uuid()) @db.Uuid
  ticketId      String          @map("ticket_id") @db.Uuid
  level         EscalationLevel
  reason        String
  escalatedById String          @map("escalated_by_id") @db.Uuid
  resolvedAt    DateTime?       @map("resolved_at")
  createdAt     DateTime        @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  escalatedBy User          @relation("EscalationCreator", fields: [escalatedById], references: [id])

  @@index([ticketId])
  @@map("support_escalations")
}

model SupportSession {
  id            String      @id @default(uuid()) @db.Uuid
  supportUserId String      @map("support_user_id") @db.Uuid
  targetOrgId   String      @map("target_org_id") @db.Uuid
  targetUserId  String?     @map("target_user_id") @db.Uuid
  sessionType   SessionType @map("session_type")
  reason        String
  startedAt     DateTime    @default(now()) @map("started_at")
  endedAt       DateTime?   @map("ended_at")
  actionsLog    Json        @default("[]") @map("actions_log")
  ipAddress     String?     @map("ip_address")

  supportUser User         @relation("SupportSessionUser", fields: [supportUserId], references: [id])
  targetOrg   Organization @relation(fields: [targetOrgId], references: [id])
  targetUser  User?        @relation("SupportSessionTarget", fields: [targetUserId], references: [id])

  @@index([supportUserId])
  @@index([targetOrgId])
  @@index([startedAt])
  @@map("support_sessions")
}

// ── Offer Letter Models (Phase 1) ───────────────────────────────

model OfferTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  name         String
  body         String   @db.Text
  variables    Json     @default("[]")
  brandingJson Json?    @map("branding_json")
  version      Int      @default(1)
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  createdBy    User         @relation("OfferTemplateCreator", fields: [createdById], references: [id])
  offers       Offer[]

  @@index([orgId, isActive])
  @@map("offer_templates")
}

model Offer {
  id              String      @id @default(uuid()) @db.Uuid
  orgId           String      @db.Uuid
  applicationId   String      @unique @map("application_id") @db.Uuid
  templateId      String      @map("template_id") @db.Uuid
  status          OfferStatus @default(DRAFT)
  compensationId  String?     @unique @map("compensation_id") @db.Uuid
  generatedDocUrl String?     @map("generated_doc_url")
  signedDocUrl    String?     @map("signed_doc_url")
  expiresAt       DateTime?   @map("expires_at")
  firstViewedAt   DateTime?   @map("first_viewed_at")
  acceptedAt      DateTime?   @map("accepted_at")
  declinedAt      DateTime?   @map("declined_at")
  declineReason   String?     @map("decline_reason")
  approvalChain   Json        @default("[]") @map("approval_chain")
  negotiationLog  Json        @default("[]") @map("negotiation_log")
  candidateToken  String?     @unique @map("candidate_token")
  createdById     String      @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization     Organization         @relation(fields: [orgId], references: [id])
  template         OfferTemplate        @relation(fields: [templateId], references: [id])
  application      CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  compensation     Compensation?        @relation(fields: [compensationId], references: [id])
  createdBy        User                 @relation("OfferCreator", fields: [createdById], references: [id])
  signatureRequest ESignRequest?
  docVersions      OfferDocVersion[]
  joining          CandidateJoining?
  bgvProfile       BgvProfile?

  @@index([orgId, status])
  @@map("offers")
}

model OfferDocVersion {
  id         String   @id @default(uuid()) @db.Uuid
  offerId    String   @map("offer_id") @db.Uuid
  version    Int
  s3Key      String   @map("s3_key")
  renderedAt DateTime @default(now()) @map("rendered_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, version])
  @@index([offerId])
  @@map("offer_doc_versions")
}

model Compensation {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  fixedAnnual    Decimal  @map("fixed_annual") @db.Decimal(12, 2)
  variableAnnual Decimal  @default(0) @map("variable_annual") @db.Decimal(12, 2)
  joiningBonus   Decimal  @default(0) @map("joining_bonus") @db.Decimal(12, 2)
  retentionBonus Decimal  @default(0) @map("retention_bonus") @db.Decimal(12, 2)
  esopUnits      Int?     @default(0) @map("esop_units")
  esopVesting    Json?    @map("esop_vesting")
  breakup        Json     @default("{}")
  currency       String   @default("INR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  offer Offer?

  @@index([orgId])
  @@map("compensations")
}

model ESignRequest {
  id            String       @id @default(uuid()) @db.Uuid
  offerId       String       @unique @map("offer_id") @db.Uuid
  provider      ESignProvider @default(DIGIO)
  providerReqId String       @unique @map("provider_req_id")
  signerEmail   String       @map("signer_email")
  signerPhone   String?      @map("signer_phone")
  status        ESignStatus  @default(PENDING)
  sentAt        DateTime?    @map("sent_at")
  signedAt      DateTime?    @map("signed_at")
  expiresAt     DateTime?    @map("expires_at")
  auditTrailUrl String?      @map("audit_trail_url")
  webhookEvents Json         @default("[]") @map("webhook_events")
  lastPolledAt  DateTime?    @map("last_polled_at")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("esign_requests")
}

// ── Joining Models (Phase 1) ────────────────────────────────────

model JoiningChecklist {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  items     Json     @default("[]")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization      @relation(fields: [orgId], references: [id])
  candidateJoinings CandidateJoining[]

  @@index([orgId, isDefault])
  @@map("joining_checklists")
}

model CandidateJoining {
  id              String        @id @default(uuid()) @db.Uuid
  offerId         String        @unique @map("offer_id") @db.Uuid
  checklistId     String        @map("checklist_id") @db.Uuid
  joinDate        DateTime      @map("join_date")
  status          JoiningStatus @default(PENDING)
  submissions     Json          @default("{}")
  buddyUserId     String?       @map("buddy_user_id") @db.Uuid
  reportingMgrId  String?       @map("reporting_mgr_id") @db.Uuid
  candidateToken  String        @unique @map("candidate_token")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  offer            Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  checklist        JoiningChecklist @relation(fields: [checklistId], references: [id])
  buddy            User?            @relation("JoiningBuddy", fields: [buddyUserId], references: [id])
  reportingManager User?            @relation("JoiningReportingManager", fields: [reportingMgrId], references: [id])

  @@index([status])
  @@map("candidate_joinings")
}

// ── BGV Models (Phase 2) ────────────────────────────────────────

model BgvProfile {
  id             String           @id @default(uuid()) @db.Uuid
  orgId          String           @db.Uuid
  candidateId    String           @map("candidate_id") @db.Uuid
  offerId        String?          @unique @map("offer_id") @db.Uuid
  status         BgvProfileStatus @default(NOT_STARTED)
  vendor         BgvVendor        @default(AUTHBRIDGE)
  vendorRefId    String?          @map("vendor_ref_id")
  consentedAt    DateTime?        @map("consented_at")
  consentIpHash  String?          @map("consent_ip_hash")
  consentDocUrl  String?          @map("consent_doc_url")
  consentToken   String           @unique @map("consent_token")
  consentOtp     String?          @map("consent_otp")
  consentOtpExp  DateTime?        @map("consent_otp_exp")
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  finalReportUrl String?          @map("final_report_url")
  riskScore      BgvRiskScore?    @map("risk_score")
  aiSummary      Json?            @map("ai_summary")
  retentionDays  Int              @default(90) @map("retention_days")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  candidate    Candidate    @relation(fields: [candidateId], references: [id])
  offer        Offer?       @relation(fields: [offerId], references: [id])
  checks       BgvCheck[]

  @@index([orgId, status])
  @@index([candidateId])
  @@map("bgv_profiles")
}

model BgvCheck {
  id            String         @id @default(uuid()) @db.Uuid
  profileId     String         @map("profile_id") @db.Uuid
  type          BgvCheckType
  status        BgvCheckStatus @default(QUEUED)
  vendorRefId   String?        @map("vendor_ref_id")
  request       Json           @default("{}")
  response      Json?
  finding       BgvFinding     @default(PENDING)
  reportUrl     String?        @map("report_url")
  costInPaise   Int?           @map("cost_in_paise")
  retryCount    Int            @default(0) @map("retry_count")
  failureReason String?        @map("failure_reason")
  startedAt     DateTime?      @map("started_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  profile BgvProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([type])
  @@map("bgv_checks")
}

// ── Appraisal Models (Phase 3) ──────────────────────────────────

model AppraisalCycle {
  id                     String      @id @default(uuid()) @db.Uuid
  orgId                  String      @db.Uuid
  name                   String
  type                   CycleType
  status                 CycleStatus @default(DRAFT)
  startDate              DateTime    @map("start_date")
  endDate                DateTime    @map("end_date")
  goalSettingDeadline    DateTime    @map("goal_setting_deadline")
  selfAssessmentDeadline DateTime    @map("self_assessment_deadline")
  managerReviewDeadline  DateTime    @map("manager_review_deadline")
  calibrationDeadline    DateTime    @map("calibration_deadline")
  ratingScale            Json        @default("[]") @map("rating_scale")
  weights                Json        @default("{}")
  eligibilityRules       Json        @default("{}") @map("eligibility_rules")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  goals        Goal[]
  assessments  AppraisalAssessment[]
  peerRequests PeerFeedbackRequest[]
  orgGoals     OrgGoal[]
  calibrations CalibrationSession[]

  @@index([orgId, status])
  @@map("appraisal_cycles")
}

model OrgGoal {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  cycleId     String   @map("cycle_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  ownerId     String?  @map("owner_id") @db.Uuid
  title       String
  description String?
  metric      String?
  target      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id])
  cycle        AppraisalCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  parent       OrgGoal?        @relation("OrgGoalTree", fields: [parentId], references: [id])
  children     OrgGoal[]       @relation("OrgGoalTree")
  owner        User?           @relation("OrgGoalOwner", fields: [ownerId], references: [id])
  alignedGoals Goal[]          @relation("GoalAlignedOrgGoal")

  @@index([orgId, cycleId])
  @@map("org_goals")
}

model Goal {
  id                 String     @id @default(uuid()) @db.Uuid
  cycleId            String     @map("cycle_id") @db.Uuid
  employeeId         String     @map("employee_id") @db.Uuid
  managerId          String     @map("manager_id") @db.Uuid
  alignedToOrgGoalId String?    @map("aligned_to_org_goal_id") @db.Uuid
  type               GoalType
  status             GoalStatus @default(DRAFT)
  title              String
  description        String?
  metrics            String?
  weight             Int        @default(0)
  selfRating         Int?       @map("self_rating")
  managerRating      Int?       @map("manager_rating")
  selfComment        String?    @map("self_comment")
  managerComment     String?    @map("manager_comment")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  cycle           AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee        User           @relation("GoalEmployee", fields: [employeeId], references: [id])
  manager         User           @relation("GoalManager", fields: [managerId], references: [id])
  alignedToOrgGoal OrgGoal?      @relation("GoalAlignedOrgGoal", fields: [alignedToOrgGoalId], references: [id])

  @@index([cycleId, employeeId])
  @@index([managerId])
  @@map("goals")
}

model AppraisalAssessment {
  id                String           @id @default(uuid()) @db.Uuid
  cycleId           String           @map("cycle_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  managerId         String           @map("manager_id") @db.Uuid
  type              AssessmentType
  status            AssessmentStatus @default(DRAFT)
  formData          Json             @default("{}") @map("form_data")
  competencyRatings Json             @default("{}") @map("competency_ratings")
  goalsRollup       Json             @default("{}") @map("goals_rollup")
  finalRating       Decimal?         @map("final_rating") @db.Decimal(3, 2)
  ratingLabel       String?          @map("rating_label")
  selfSummary       String?          @map("self_summary")
  managerSummary    String?          @map("manager_summary")
  aiSummary         Json?            @map("ai_summary")
  submittedAt       DateTime?        @map("submitted_at")
  reviewedAt        DateTime?        @map("reviewed_at")
  finalisedAt       DateTime?        @map("finalised_at")
  acknowledgedAt    DateTime?        @map("acknowledged_at")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  cycle    AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee User           @relation("AssessmentEmployee", fields: [employeeId], references: [id])
  manager  User           @relation("AssessmentManager", fields: [managerId], references: [id])

  @@unique([cycleId, employeeId, type])
  @@index([cycleId, status])
  @@index([managerId])
  @@map("appraisal_assessments")
}

model PeerFeedbackRequest {
  id             String                @id @default(uuid()) @db.Uuid
  cycleId        String                @map("cycle_id") @db.Uuid
  subjectUserId  String                @map("subject_user_id") @db.Uuid
  reviewerUserId String                @map("reviewer_user_id") @db.Uuid
  requestedById  String                @map("requested_by_id") @db.Uuid
  relationship   PeerRelationship
  status         FeedbackRequestStatus @default(REQUESTED)
  isAnonymous    Boolean               @default(true) @map("is_anonymous")
  formData       Json?                 @map("form_data")
  reviewerToken  String                @unique @map("reviewer_token")
  declinedReason String?               @map("declined_reason")
  submittedAt    DateTime?             @map("submitted_at")
  expiresAt      DateTime?             @map("expires_at")
  requestedAt    DateTime              @default(now()) @map("requested_at")

  cycle       AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subject     User           @relation("PeerSubject", fields: [subjectUserId], references: [id])
  reviewer    User           @relation("PeerReviewer", fields: [reviewerUserId], references: [id])
  requestedBy User           @relation("PeerRequester", fields: [requestedById], references: [id])

  @@unique([cycleId, subjectUserId, reviewerUserId])
  @@index([cycleId, status])
  @@map("peer_feedback_requests")
}

model CalibrationSession {
  id                 String            @id @default(uuid()) @db.Uuid
  cycleId            String            @map("cycle_id") @db.Uuid
  groupName          String            @map("group_name")
  facilitatorId      String            @map("facilitator_id") @db.Uuid
  participantUserIds String[]          @map("participant_user_ids") @db.Uuid
  scope              Json              @default("{}")
  targetDistribution Json              @default("{}") @map("target_distribution")
  decisionLog        Json              @default("[]") @map("decision_log")
  status             CalibrationStatus @default(SCHEDULED)
  scheduledAt        DateTime          @map("scheduled_at")
  lockedAt           DateTime?         @map("locked_at")
  completedAt        DateTime?         @map("completed_at")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  cycle       AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  facilitator User           @relation("CalibrationFacilitator", fields: [facilitatorId], references: [id])

  @@index([cycleId, status])
  @@map("calibration_sessions")
}

// ── Compensation Engine Models (Phase 4) ────────────────────────

model AppraisalBudget {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @db.Uuid
  cycleId          String       @unique @map("cycle_id") @db.Uuid
  hikePoolINR      Decimal      @map("hike_pool_inr") @db.Decimal(14, 2)
  bonusPoolINR     Decimal      @map("bonus_pool_inr") @db.Decimal(14, 2)
  splits           Json         @default("[]")
  matrix           Json         @default("{}")
  bonusMatrix      Json         @default("{}") @map("bonus_matrix")
  marketCorrection Json         @default("[]") @map("market_correction")
  retentionRules   Json         @default("[]") @map("retention_rules")
  hikeCapPct       Decimal      @default(50) @map("hike_cap_pct") @db.Decimal(5, 2)
  status           BudgetStatus @default(DRAFT)
  approvedById     String?      @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?    @map("approved_at")
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization           @relation(fields: [orgId], references: [id])
  approvedBy   User?                  @relation("BudgetApprover", fields: [approvedById], references: [id])
  revisions    CompensationRevision[]
  snapshots    CompensationSnapshot[]

  @@index([orgId, status])
  @@map("appraisal_budgets")
}

model CompensationRevision {
  id               String         @id @default(uuid()) @db.Uuid
  orgId            String         @db.Uuid
  cycleId          String         @map("cycle_id") @db.Uuid
  budgetId         String         @map("budget_id") @db.Uuid
  employeeId       String         @map("employee_id") @db.Uuid
  currentFixed     Decimal        @map("current_fixed") @db.Decimal(12, 2)
  currentVariable  Decimal        @default(0) @map("current_variable") @db.Decimal(12, 2)
  rating           Decimal?       @db.Decimal(3, 2)
  computedHikePct  Decimal        @default(0) @map("computed_hike_pct") @db.Decimal(5, 2)
  computedHikeINR  Decimal        @default(0) @map("computed_hike_inr") @db.Decimal(12, 2)
  computedBonusINR Decimal        @default(0) @map("computed_bonus_inr") @db.Decimal(12, 2)
  finalHikePct     Decimal        @default(0) @map("final_hike_pct") @db.Decimal(5, 2)
  finalHikeINR     Decimal        @default(0) @map("final_hike_inr") @db.Decimal(12, 2)
  finalBonusINR    Decimal        @default(0) @map("final_bonus_inr") @db.Decimal(12, 2)
  newFixed         Decimal        @default(0) @map("new_fixed") @db.Decimal(12, 2)
  newVariable      Decimal        @default(0) @map("new_variable") @db.Decimal(12, 2)
  effectiveDate    DateTime       @map("effective_date")
  managerComment   String?        @map("manager_comment")
  overrideReason   String?        @map("override_reason")
  approvalChain    Json           @default("[]") @map("approval_chain")
  retentionTier    String?        @map("retention_tier")
  scopeKey         String?        @map("scope_key")
  letterUrl        String?        @map("letter_url")
  letterStatus     CompLetterStatus @default(PENDING) @map("letter_status")
  letterIssuedAt   DateTime?      @map("letter_issued_at")
  oneOnOneAt       DateTime?      @map("one_on_one_at")
  acknowledgedAt   DateTime?      @map("acknowledged_at")
  status           RevisionStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  budget       AppraisalBudget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  employee     User             @relation("RevisionEmployee", fields: [employeeId], references: [id])

  @@unique([cycleId, employeeId])
  @@index([orgId, status])
  @@index([budgetId])
  @@map("compensation_revisions")
}

model CompensationSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  budgetId    String   @map("budget_id") @db.Uuid
  name        String
  description String?
  payload     Json     @default("{}")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now())

  budget AppraisalBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("compensation_snapshots")
}

// ── Phase 5: Reports / Notifications / Security / Perf ──────────

model ReportDefinition {
  id             String              @id @default(uuid()) @db.Uuid
  orgId          String              @db.Uuid
  name           String
  description    String?
  dataSource     ReportSource        @map("data_source")
  filters        Json                @default("{}")
  groupBy        String[]            @default([]) @map("group_by")
  metrics        Json                @default("[]")
  visualization  ReportVisualization @default(TABLE)
  scheduleCron   String?             @map("schedule_cron")
  scheduleTargets Json               @default("[]") @map("schedule_targets")
  createdById    String              @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lastRunAt      DateTime?           @map("last_run_at")

  organization Organization @relation(fields: [orgId], references: [id])
  createdBy    User         @relation("ReportCreator", fields: [createdById], references: [id])

  @@index([orgId])
  @@map("report_definitions")
}

model UserNotificationPref {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  eventType String              @map("event_type")
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@map("user_notification_prefs")
}

model NotificationLog {
  id          String                     @id @default(uuid()) @db.Uuid
  orgId       String                     @db.Uuid
  userId      String?                    @map("user_id") @db.Uuid
  channel     NotificationChannel
  templateKey String                     @map("template_key")
  toAddress   String                     @map("to_address")
  payload     Json                       @default("{}")
  status      NotificationDeliveryStatus @default(QUEUED)
  providerId  String?                    @map("provider_id")
  costInPaise Int?                       @map("cost_in_paise")
  sentAt      DateTime?                  @map("sent_at")
  deliveredAt DateTime?                  @map("delivered_at")
  errorMessage String?                   @map("error_message")
  createdAt   DateTime                   @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@index([status])
  @@map("notification_logs")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model SecurityLog {
  id         String            @id @default(uuid()) @db.Uuid
  orgId      String            @db.Uuid
  eventType  SecurityEventType @map("event_type")
  userId     String?           @map("user_id") @db.Uuid
  ipAddress  String?           @map("ip_address")
  userAgent  String?           @map("user_agent")
  payload    Json              @default("{}")
  prevHash   String?           @map("prev_hash")
  hash       String
  createdAt  DateTime          @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([hash])
  @@map("security_logs")
}

model AiCallLog {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String?  @db.Uuid
  agentName    String   @map("agent_name")
  modelUsed    String   @map("model_used")
  tokensInput  Int?     @map("tokens_input")
  tokensOutput Int?     @map("tokens_output")
  costInPaise  Int?     @map("cost_in_paise")
  cacheHit     Boolean  @default(false) @map("cache_hit")
  status       String
  latencyMs    Int?     @map("latency_ms")
  createdAt    DateTime @default(now())

  organization Organization? @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([agentName])
  @@map("ai_call_logs")
}

// ── AI Dashboard Insights ───────────────────────────────────────

model DashboardInsight {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  generatedBy String   @db.Uuid @map("generated_by")
  insights    Json
  generatedAt DateTime @default(now()) @map("generated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [generatedBy], references: [id])

  @@index([orgId, generatedAt(sort: Desc)])
  @@map("dashboard_insights")
}
