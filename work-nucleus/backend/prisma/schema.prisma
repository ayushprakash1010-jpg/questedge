generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  HIRING_MANAGER
  INTERVIEWER
  VIEWER
  SUPPORT_REP
  SUPPORT_ADMIN
}

enum SkillCategory {
  TECHNICAL
  LEADERSHIP
  BEHAVIOURAL
  COMMUNICATION
  DOMAIN
}

enum HiringPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SkillPriority {
  MUST_HAVE
  NICE_TO_HAVE
}

enum JdStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
}

enum StageType {
  SCREENING
  TECHNICAL
  HR
  LEADERSHIP
  CULTURAL
  OFFER
  CUSTOM
}

enum CandidateSource {
  REFERRAL
  JOB_BOARD
  DIRECT
  AGENCY
  INTERNAL
}

enum ApplicationStatus {
  ACTIVE
  SELECTED
  REJECTED
  ON_HOLD
  WITHDRAWN
}

enum StageOutcome {
  PASSED
  REJECTED
  SKIPPED
}

enum Recommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum DecisionType {
  SELECTED
  REJECTED
}

enum TrainingCategory {
  JD_FORMAT
  INTERVIEWING_SKILLS
  FEEDBACK_GUIDELINES
  HIRING_PROCESS
}

// ── Job Publishing Enums ────────────────────────────────────────

enum PublishChannel {
  LINKEDIN
  INDEED
  NAUKRI
  CUSTOM
}

enum PublishStatus {
  PENDING
  PUBLISHED
  FAILED
  REMOVED
}

// ── Support Portal Enums ────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  TECHNICAL
  BILLING
  FEATURE_REQUEST
  BUG_REPORT
  ONBOARDING
  GENERAL
}

enum EscalationLevel {
  L1
  L2
  L3
  MANAGEMENT
}

enum SessionType {
  SHADOW
  IMPERSONATE
}

// ── Core Models ─────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  hiringPlans      HiringPlan[]
  candidates       Candidate[]
  trainingModules  TrainingModule[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  settings           OrgSettings?
  healthMetrics      OrgHealthMetric[]
  jobPublishings     JobPublishing[]
  supportTickets     SupportTicket[]
  supportSessions    SupportSession[]
  dashboardInsights  DashboardInsight[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  email     String   @unique
  auth0Sub  String   @unique @map("auth0_sub")
  name      String
  role      Role     @default(VIEWER)
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  managedHiringPlans HiringPlan[] @relation("HiringManager")
  createdHiringPlans HiringPlan[] @relation("PlanCreator")
  createdJobDescriptions  JobDescription[] @relation("JdCreator")
  approvedJobDescriptions JobDescription[] @relation("JdApprover")
  stageAssignments        PipelineStageInterviewer[]
  interviewFeedbacks      InterviewFeedback[]
  decisionsDecided        SelectionDecision[]  @relation("DecisionDecider")
  decisionsApproved       SelectionDecision[]  @relation("DecisionApprover")
  trainingCompletions     TrainingCompletion[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  assignedTickets         SupportTicket[]      @relation("TicketAssignee")
  supportNotes            SupportNote[]        @relation("NoteAuthor")
  escalationsCreated      SupportEscalation[]  @relation("EscalationCreator")
  supportSessions         SupportSession[]     @relation("SupportSessionUser")
  targetedBySessions      SupportSession[]     @relation("SupportSessionTarget")
  dashboardInsights       DashboardInsight[]

  @@index([orgId])
  @@index([auth0Sub])
  @@map("users")
}

model Skill {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  category  SkillCategory
  industry  String?
  isGlobal  Boolean       @default(false) @map("is_global")
  createdAt DateTime      @default(now())

  hiringPlanSkills    HiringPlanSkill[]
  feedbackRatings     FeedbackSkillRating[]

  @@map("skills")
}

model HiringPlan {
  id                   String           @id @default(uuid()) @db.Uuid
  orgId                String           @db.Uuid
  title                String
  industry             String
  department           String
  quarter              Int
  year                 Int
  totalRoles           Int              @map("total_roles")
  filledRoles          Int              @default(0) @map("filled_roles")
  status               HiringPlanStatus @default(DRAFT)
  budgetMin            Decimal          @map("budget_min") @db.Decimal(12, 2)
  budgetMax            Decimal          @map("budget_max") @db.Decimal(12, 2)
  currency             String           @default("INR")
  benefits             Json             @default("[]")
  hiringManagerId      String           @map("hiring_manager_id") @db.Uuid
  reportingManagerName String           @map("reporting_manager_name")
  hodName              String           @map("hod_name")
  teamSize             Int?             @map("team_size")
  teamLevels           String?          @map("team_levels")
  designation          String
  notes                String?
  createdById          String           @map("created_by_id") @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization   Organization      @relation(fields: [orgId], references: [id])
  hiringManager  User              @relation("HiringManager", fields: [hiringManagerId], references: [id])
  createdBy      User              @relation("PlanCreator", fields: [createdById], references: [id])
  skills           HiringPlanSkill[]
  jobDescriptions  JobDescription[]
  pipelineStages   PipelineStage[]
  applications     CandidateApplication[]
  publishings      JobPublishing[]

  @@index([orgId])
  @@index([status])
  @@index([hiringManagerId])
  @@map("hiring_plans")
}

model HiringPlanSkill {
  id             String        @id @default(uuid()) @db.Uuid
  hiringPlanId   String        @map("hiring_plan_id") @db.Uuid
  skillId        String        @map("skill_id") @db.Uuid
  priority       SkillPriority
  minProficiency Int           @map("min_proficiency")

  hiringPlan HiringPlan @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id])

  @@unique([hiringPlanId, skillId])
  @@map("hiring_plan_skills")
}

model JobDescription {
  id                   String   @id @default(uuid()) @db.Uuid
  hiringPlanId         String   @map("hiring_plan_id") @db.Uuid
  version              Int      @default(1)
  content              Json     @default("{}")
  fitmentMapping       Json     @default("{}") @map("fitment_mapping")
  evaluationParameters Json     @default("{}") @map("evaluation_parameters")
  generatedByAi        Boolean  @default(true) @map("generated_by_ai")
  aiPromptUsed         String?  @map("ai_prompt_used")
  status               JdStatus @default(DRAFT)
  createdById          String   @map("created_by_id") @db.Uuid
  approvedById         String?  @map("approved_by_id") @db.Uuid
  approvedAt           DateTime? @map("approved_at")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hiringPlan  HiringPlan      @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("JdCreator", fields: [createdById], references: [id])
  approvedBy  User?           @relation("JdApprover", fields: [approvedById], references: [id])
  publishings JobPublishing[]

  @@index([hiringPlanId])
  @@index([status])
  @@map("job_descriptions")
}

model PipelineStage {
  id               String    @id @default(uuid()) @db.Uuid
  hiringPlanId     String    @map("hiring_plan_id") @db.Uuid
  name             String
  stageOrder       Int       @map("stage_order")
  stageType        StageType @map("stage_type")
  maxDurationDays  Int?      @map("max_duration_days")
  skillsToEvaluate Json      @default("[]") @map("skills_to_evaluate")
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hiringPlan   HiringPlan                @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  interviewers PipelineStageInterviewer[]
  applications CandidateApplication[]    @relation("CurrentStage")
  stageHistory CandidateStageHistory[]
  feedbacks    InterviewFeedback[]

  @@index([hiringPlanId])
  @@map("pipeline_stages")
}

model PipelineStageInterviewer {
  id          String  @id @default(uuid()) @db.Uuid
  stageId     String  @map("stage_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  isMandatory Boolean @default(false) @map("is_mandatory")

  stage PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@unique([stageId, userId])
  @@map("pipeline_stage_interviewers")
}

model Candidate {
  id              String          @id @default(uuid()) @db.Uuid
  orgId           String          @db.Uuid
  name            String
  email           String
  phone           String?
  resumeUrl       String?         @map("resume_url")
  source          CandidateSource
  currentCompany  String?         @map("current_company")
  currentRole     String?         @map("current_role")
  experienceYears Decimal?        @map("experience_years") @db.Decimal(4, 1)
  expectedCtc     Decimal?        @map("expected_ctc") @db.Decimal(12, 2)
  noticePeriodDays Int?           @map("notice_period_days")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization           @relation(fields: [orgId], references: [id])
  applications CandidateApplication[]

  @@unique([orgId, email])
  @@index([orgId])
  @@map("candidates")
}

model CandidateApplication {
  id              String            @id @default(uuid()) @db.Uuid
  candidateId     String            @map("candidate_id") @db.Uuid
  hiringPlanId    String            @map("hiring_plan_id") @db.Uuid
  currentStageId  String?           @map("current_stage_id") @db.Uuid
  status          ApplicationStatus @default(ACTIVE)
  appliedAt       DateTime          @default(now()) @map("applied_at")
  stageEnteredAt  DateTime          @default(now()) @map("stage_entered_at")
  completedAt     DateTime?         @map("completed_at")
  rejectionReason String?           @map("rejection_reason")
  selectionNotes  String?           @map("selection_notes")
  coverLetter     String?           @map("cover_letter")
  totalScore      Decimal?          @map("total_score") @db.Decimal(5, 2)
  aiSummary       String?           @map("ai_summary")
  aiMatchScore    Decimal?          @map("ai_match_score") @db.Decimal(5, 2)
  aiMatchSummary  String?           @map("ai_match_summary")

  candidate    Candidate               @relation(fields: [candidateId], references: [id])
  hiringPlan   HiringPlan              @relation(fields: [hiringPlanId], references: [id], onDelete: Cascade)
  currentStage PipelineStage?          @relation("CurrentStage", fields: [currentStageId], references: [id])
  stageHistory CandidateStageHistory[]
  feedbacks    InterviewFeedback[]
  decision     SelectionDecision?

  @@unique([candidateId, hiringPlanId])
  @@index([hiringPlanId])
  @@index([currentStageId])
  @@map("candidate_applications")
}

model CandidateStageHistory {
  id            String        @id @default(uuid()) @db.Uuid
  applicationId String        @map("application_id") @db.Uuid
  stageId       String        @map("stage_id") @db.Uuid
  enteredAt     DateTime      @default(now()) @map("entered_at")
  exitedAt      DateTime?     @map("exited_at")
  outcome       StageOutcome?

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage       PipelineStage        @relation(fields: [stageId], references: [id])

  @@index([applicationId])
  @@map("candidate_stage_history")
}

model InterviewFeedback {
  id               String         @id @default(uuid()) @db.Uuid
  applicationId    String         @map("application_id") @db.Uuid
  stageId          String         @map("stage_id") @db.Uuid
  interviewerId    String         @map("interviewer_id") @db.Uuid
  overallRating    Int            @map("overall_rating")
  recommendation   Recommendation
  qualitativeNotes String?        @map("qualitative_notes")
  strengths        String?
  concerns         String?
  durationMinutes  Int?           @map("duration_minutes")
  isSubmitted      Boolean        @default(false) @map("is_submitted")
  submittedAt      DateTime?      @map("submitted_at")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  application  CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage        PipelineStage        @relation(fields: [stageId], references: [id])
  interviewer  User                 @relation(fields: [interviewerId], references: [id])
  skillRatings FeedbackSkillRating[]

  @@unique([applicationId, stageId, interviewerId])
  @@index([applicationId])
  @@index([interviewerId])
  @@map("interview_feedbacks")
}

model FeedbackSkillRating {
  id         String  @id @default(uuid()) @db.Uuid
  feedbackId String  @map("feedback_id") @db.Uuid
  skillId    String  @map("skill_id") @db.Uuid
  rating     Int
  notes      String?

  feedback InterviewFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  skill    Skill             @relation(fields: [skillId], references: [id])

  @@unique([feedbackId, skillId])
  @@map("feedback_skill_ratings")
}

model SelectionDecision {
  id                  String       @id @default(uuid()) @db.Uuid
  applicationId       String       @unique @map("application_id") @db.Uuid
  decision            DecisionType
  decidedById         String       @map("decided_by_id") @db.Uuid
  decisionNotes       String?      @map("decision_notes")
  approvedById        String?      @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?    @map("approved_at")
  offerCtc            Decimal?     @map("offer_ctc") @db.Decimal(12, 2)
  offerDesignation    String?      @map("offer_designation")
  joiningDate         DateTime?    @map("joining_date")
  communicationDraft  Json?        @map("communication_draft")
  communicationSent   Boolean      @default(false) @map("communication_sent")
  communicationSentAt DateTime?    @map("communication_sent_at")
  createdAt           DateTime     @default(now())

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decidedBy   User                 @relation("DecisionDecider", fields: [decidedById], references: [id])
  approvedBy  User?                @relation("DecisionApprover", fields: [approvedById], references: [id])

  @@index([applicationId])
  @@map("selection_decisions")
}

model TrainingModule {
  id               String           @id @default(uuid()) @db.Uuid
  orgId            String           @db.Uuid
  title            String
  contentMarkdown  String           @map("content_markdown")
  category         TrainingCategory
  isDefault        Boolean          @default(false) @map("is_default")
  estimatedMinutes Int?             @map("estimated_minutes")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id])
  completions  TrainingCompletion[]

  @@index([orgId])
  @@map("training_modules")
}

model TrainingCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  moduleId    String   @map("module_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at")

  user   User           @relation(fields: [userId], references: [id])
  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("training_completions")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  orgId      String   @db.Uuid
  type       String
  title      String
  body       String
  read       Boolean  @default(false)
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  actionUrl  String?  @map("action_url")
  createdAt  DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([userId, read])
  @@index([orgId])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OrgSettings {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @unique @db.Uuid
  settings Json     @default("{}")
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("org_settings")
}

// ── Job Publishing Models ───────────────────────────────────────

model JobPublishing {
  id               String         @id @default(uuid()) @db.Uuid
  jobDescriptionId String         @map("job_description_id") @db.Uuid
  hiringPlanId     String         @map("hiring_plan_id") @db.Uuid
  orgId            String         @db.Uuid
  channel          PublishChannel
  status           PublishStatus  @default(PENDING)
  externalJobId    String?        @map("external_job_id")
  externalUrl      String?        @map("external_url")
  publicSlug       String         @unique @map("public_slug")
  publishedAt      DateTime?      @map("published_at")
  errorMessage     String?        @map("error_message")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id])
  hiringPlan     HiringPlan     @relation(fields: [hiringPlanId], references: [id])
  organization   Organization   @relation(fields: [orgId], references: [id])

  @@index([hiringPlanId])
  @@index([publicSlug])
  @@map("job_publishings")
}

// ── Support Portal Models ───────────────────────────────────────

model OrgHealthMetric {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @db.Uuid
  metricDate      DateTime @map("metric_date")
  activeUsers     Int      @map("active_users")
  hiringPlanCount Int      @map("hiring_plan_count")
  openRoles       Int      @map("open_roles")
  fillRate        Decimal  @map("fill_rate") @db.Decimal(5, 2)
  avgTimeToHire   Int?     @map("avg_time_to_hire")
  healthScore     Int      @map("health_score")
  riskFlags       Json     @default("[]") @map("risk_flags")
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, metricDate])
  @@index([orgId])
  @@index([metricDate])
  @@map("org_health_metrics")
}

model SupportTicket {
  id              String         @id @default(uuid()) @db.Uuid
  orgId           String         @db.Uuid
  title           String
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  category        TicketCategory @default(GENERAL)
  assigneeId      String?        @map("assignee_id") @db.Uuid
  reportedBy      String         @map("reported_by")
  slaDeadline     DateTime?      @map("sla_deadline")
  firstResponseAt DateTime?      @map("first_response_at")
  resolvedAt      DateTime?      @map("resolved_at")
  closedAt        DateTime?      @map("closed_at")
  tags            Json           @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  assignee     User?             @relation("TicketAssignee", fields: [assigneeId], references: [id])
  notes        SupportNote[]
  escalations  SupportEscalation[]

  @@index([orgId])
  @@index([status])
  @@index([assigneeId])
  @@index([priority])
  @@index([slaDeadline])
  @@map("support_tickets")
}

model SupportNote {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String
  isInternal Boolean  @default(true) @map("is_internal")
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("support_notes")
}

model SupportEscalation {
  id            String          @id @default(uuid()) @db.Uuid
  ticketId      String          @map("ticket_id") @db.Uuid
  level         EscalationLevel
  reason        String
  escalatedById String          @map("escalated_by_id") @db.Uuid
  resolvedAt    DateTime?       @map("resolved_at")
  createdAt     DateTime        @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  escalatedBy User          @relation("EscalationCreator", fields: [escalatedById], references: [id])

  @@index([ticketId])
  @@map("support_escalations")
}

model SupportSession {
  id            String      @id @default(uuid()) @db.Uuid
  supportUserId String      @map("support_user_id") @db.Uuid
  targetOrgId   String      @map("target_org_id") @db.Uuid
  targetUserId  String?     @map("target_user_id") @db.Uuid
  sessionType   SessionType @map("session_type")
  reason        String
  startedAt     DateTime    @default(now()) @map("started_at")
  endedAt       DateTime?   @map("ended_at")
  actionsLog    Json        @default("[]") @map("actions_log")
  ipAddress     String?     @map("ip_address")

  supportUser User         @relation("SupportSessionUser", fields: [supportUserId], references: [id])
  targetOrg   Organization @relation(fields: [targetOrgId], references: [id])
  targetUser  User?        @relation("SupportSessionTarget", fields: [targetUserId], references: [id])

  @@index([supportUserId])
  @@index([targetOrgId])
  @@index([startedAt])
  @@map("support_sessions")
}

// ── AI Dashboard Insights ───────────────────────────────────────

model DashboardInsight {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  generatedBy String   @db.Uuid @map("generated_by")
  insights    Json
  generatedAt DateTime @default(now()) @map("generated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [generatedBy], references: [id])

  @@index([orgId, generatedAt(sort: Desc)])
  @@map("dashboard_insights")
}
