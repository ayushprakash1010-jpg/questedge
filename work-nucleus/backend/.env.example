# Database (Neon / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/questedge?schema=public"

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
# Optional: canonical *.auth0.com domain when AUTH0_DOMAIN uses a custom domain
AUTH0_MANAGEMENT_DOMAIN=
AUTH0_AUDIENCE=https://api.questedge.com
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-client-secret
AUTH0_SYNC_SECRET=replace-with-strong-random-secret

# Platform Support Admins & Optional Demo Account
SUPPORT_ADMIN_SUBS=
SUPPORT_ADMIN_EMAILS=
DEMO_AUTH0_SUB=
DEMO_EMAIL=

# Frontend & CORS
FRONTEND_URL=http://localhost:3001
EXTRA_CORS_ORIGINS=
ENABLE_SWAGGER=false

# App
PORT=3000
NODE_ENV=development

# Email (Resend) — used for notifications, offers & BGV consent OTP
RESEND_API_KEY=
RESEND_FROM_EMAIL="QuestEdge <noreply@questedge.in>"

# AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Object Storage (S3 / R2 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=questedge-files
S3_OFFERS_BUCKET=questedge-offers

# BGV Vendors & Webhooks
AUTHBRIDGE_BASE_URL=
AUTHBRIDGE_API_KEY=
AUTHBRIDGE_WEBHOOK_SECRET=
ONGRID_BASE_URL=
ONGRID_API_KEY=
IDFY_BASE_URL=
IDFY_API_KEY=

# Offer e-Sign Vendors & Webhooks
DIGIO_BASE_URL=
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_WEBHOOK_SECRET=
LEGALITY_BASE_URL=
LEGALITY_AUTH_TOKEN=

# Post-Launch Integrations (Optional at launch)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
MSG91_BASE_URL=https://control.msg91.com/api/v5
MSG91_AUTH_KEY=
MSG91_SMS_SENDER_ID=WRKNCS
MSG91_WA_NUMBER=
MSG91_WEBHOOK_SECRET=
