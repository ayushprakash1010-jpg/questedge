# ============================================
# Work Nucleus — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=work_nucleus

# --- Auth0 (Backend JWT Validation) ---
JWT_ISSUER=https://your-tenant.auth0.com/
JWT_AUDIENCE=https://api.work-nucleus.com
JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json

# --- Auth0 (Frontend) ---
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_SECRET=replace-with-openssl-rand-hex-32
AUTH0_BASE_URL=http://localhost:3001
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.work-nucleus.com
AUTH0_SCOPE=openid profile email

# --- Auth0 (Support Admin — separate application, no signup) ---
AUTH0_SUPPORT_CLIENT_ID=your-support-client-id
AUTH0_SUPPORT_CLIENT_SECRET=your-support-client-secret
AUTH0_SUPPORT_CONNECTION=your-support-db-connection
AUTH0_SUPPORT_BASE_URL=http://localhost:3002

# --- Auth0 (Management API — for user sync) ---
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-client-secret
AUTH0_SYNC_SECRET=your-webhook-sync-secret

# --- AI Service ---
ANTHROPIC_API_KEY=sk-ant-your-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Internal Service Communication ---
INTERNAL_API_KEY=generate_a_secure_random_key

# --- URLs ---
NEXT_PUBLIC_API_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# --- Mock Mode (Frontend) ---
# Set to "true" to use mock data — no backend/DB required
NEXT_PUBLIC_USE_MOCK_DATA=false

# --- Production ---
APP_PORT=80
NODE_ENV=production
