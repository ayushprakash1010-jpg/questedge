# Auth0 (Next.js v4 SDK)
AUTH0_SECRET=replace-with-32-byte-hex-secret
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.questedge.com
APP_BASE_URL=http://localhost:3001

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL_INTERNAL=

# PostHog Analytics (uses Next.js /ingest rewrite)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Optional WebRTC ICE configuration for Video Interviews
NEXT_PUBLIC_WEBRTC_STUN_URLS=
NEXT_PUBLIC_WEBRTC_TURN_URL=
